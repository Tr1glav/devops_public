# GitHub Cache Proxy Configuration
# Generated by Ansible - {{ ansible_date_time.iso8601 }}

proxy_cache_path {{ nginx_github_cache_path }}
    levels=1:2
    keys_zone=github_cache:{{ nginx_github_cache_keys_zone_size }}
    max_size={{ nginx_github_cache_max_size }}
    inactive={{ nginx_github_cache_inactive }}
    use_temp_path=off;

# Отдельная зона кэша для больших файлов (архивов)
proxy_cache_path {{ nginx_github_cache_path }}/assets
    levels=1:2
    keys_zone=github_assets_cache:{{ nginx_github_assets_cache_keys_zone_size | default('500m') }}
    max_size={{ nginx_github_assets_cache_max_size | default('100g') }}
    inactive={{ nginx_github_assets_cache_inactive | default('90d') }}
    use_temp_path=off;

{% if nginx_github_rate_limit_enabled  %}
# Rate limiting zone
limit_req_zone $binary_remote_addr zone={{ nginx_github_rate_limit_zone }}:10m rate={{ nginx_github_rate_limit_rate }};
{% endif  %}

# Upstream definitions
upstream github_api {
    server api.github.com:443;
    keepalive 32;
}

upstream github_raw {
    server raw.githubusercontent.com:443;
    keepalive 32;
}

upstream github_releases {
    server github.com:443;
    keepalive 32;
}

upstream github_assets_cdn {
    server release-assets.githubusercontent.com:443;
    keepalive 32;
}

# Main server block
server {
    listen {{ nginx_github_cache_port }} default_server;
    listen [::]:{{ nginx_github_cache_port }} default_server;
    server_name {{ nginx_github_cache_server_name }};

    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;

    # Client body size for large downloads
    client_max_body_size 100m;
    
    {% if nginx_github_rate_limit_enabled  %}
    # Apply rate limiting
    limit_req zone={{ nginx_github_rate_limit_zone }} burst={{ nginx_github_rate_limit_burst }} nodelay;
    limit_req_status 429;
    {% endif  %}

    # Общие настройки
    proxy_redirect off;
    proxy_intercept_errors on;
    
    # Common proxy settings
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    
    # SSL settings for upstream
    proxy_ssl_server_name on;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;
    proxy_ssl_session_reuse on;
    
    # Connection pooling
    proxy_set_header Connection "";
    proxy_buffering on;
    
    # Timeouts
    proxy_connect_timeout 30s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    
    # Buffer settings
    proxy_buffers 8 32k;
    proxy_buffer_size 32k;
    proxy_busy_buffers_size 64k;
    proxy_temp_file_write_size 64k;
    
    # Cache specific settings for API
    proxy_cache github_cache;
    proxy_cache_key "$scheme$request_method$host$request_uri$http_authorization$http_accept";
    proxy_cache_valid {{ nginx_github_cache_valid_codes }} {{ nginx_github_cache_valid_time }};
    proxy_cache_use_stale {{ nginx_github_cache_use_stale }};
    proxy_cache_background_update {{ nginx_github_cache_background_update }};
    proxy_cache_lock {{ nginx_github_cache_lock }};
    proxy_cache_lock_timeout {{ nginx_github_cache_lock_timeout }};
    
    # Add cache status header
    add_header X-Cache-Status $upstream_cache_status;
    add_header X-Proxy-Server "Nginx-GitHub-Cache";
    
    # Don't cache specific paths
    set $skip_cache 0;
    
    if ($request_method != GET) {
        set $skip_cache 1;
    }
    
    if ($http_authorization) {
        set $skip_cache 1;
    }
    
    proxy_cache_bypass $skip_cache;
    proxy_no_cache $skip_cache;

    # GitHub API endpoint
    location /api/ {
        rewrite ^/api/(.*) /$1 break;
        proxy_pass https://github_api;
        
        proxy_set_header Host api.github.com;
        proxy_set_header Accept "application/vnd.github.v3+json";
        proxy_pass_header Authorization;
        
        access_log /var/log/nginx/github-api-access.log;
        error_log /var/log/nginx/github-api-error.log;
    }
    
    # Raw GitHub content endpoint
    location /raw/ {
        rewrite ^/raw/(.*) /$1 break;
        proxy_pass https://github_raw;
        
        proxy_set_header Host raw.githubusercontent.com;
        
        access_log /var/log/nginx/github-raw-access.log;
        error_log /var/log/nginx/github-raw-error.log;
    }
    
    # GitHub releases endpoint - ИСПРАВЛЕННАЯ ВЕРСИЯ
    location /github/ {
        # Преобразуем URL
        rewrite ^/github/(.*) /$1 break;
        
        # Проксируем на GitHub
        proxy_pass https://github.com;
        
        # Заголовки
        proxy_set_header Host github.com;
        proxy_set_header Accept "*/*";
        proxy_set_header User-Agent "Mozilla/5.0 (compatible; Nginx-GitHub-Cache/1.0)";
        proxy_set_header X-Forwarded-Proto https;
        
        # SSL настройки
        proxy_ssl_server_name on;
        proxy_ssl_name github.com;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        
        # Включаем перехват редиректов
        proxy_intercept_errors on;
        error_page 301 302 307 = @follow_redirect;
        
        # Настройки для больших файлов
        proxy_buffering on;
        proxy_buffer_size 512k;
        proxy_buffers 16 512k;
        proxy_busy_buffers_size 512k;
        proxy_temp_file_write_size 512k;
        
        # Таймауты для больших файлов
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        
        # Кэширование
        proxy_cache github_assets_cache;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale updating error timeout;
        proxy_force_ranges on;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 30s;
        
        access_log /var/log/nginx/github-assets-access.log;
        error_log /var/log/nginx/github-assets-error.log;
    }
    
    # Следуем за редиректом и проксируем на assets CDN
    location @follow_redirect {
        internal;
        
        # Получаем URL редиректа и проверяем через переменную
        set $redirect_url $upstream_http_location;
        set $is_asset 0;
        
        # Проверяем, содержит ли URL release-assets.githubusercontent.com
        if ($redirect_url ~* "release-assets\.githubusercontent\.com") {
            set $is_asset 1;
        }
        
        # Если это asset, проксируем на отдельный location
        if ($is_asset = 1) {
            rewrite ^ /_proxy_asset?redirect=$redirect_url last;
        }
        
        # Иначе возвращаем редирект клиенту
        return 302 $redirect_url;
    }
    
    # Внутренний location для проксирования assets
    location /_proxy_asset {
        internal;
        
        # Получаем URL из параметра
        set $target_url $arg_redirect;
        
        # Проксируем на assets CDN
        proxy_pass $target_url;
        
        # Заголовки для assets CDN
        proxy_set_header Host release-assets.githubusercontent.com;
        proxy_set_header Accept "*/*";
        proxy_set_header User-Agent "Mozilla/5.0 (compatible; Nginx-GitHub-Cache/1.0)";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        
        # SSL настройки
        proxy_ssl_server_name on;
        proxy_ssl_name release-assets.githubusercontent.com;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        
        # Настройки для скачивания больших файлов
        proxy_buffering on;
        proxy_buffer_size 512k;
        proxy_buffers 16 512k;
        proxy_busy_buffers_size 512k;
        proxy_temp_file_write_size 512k;
        
        # Таймауты
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        
        # Кэширование
        proxy_cache github_assets_cache;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale updating error timeout;
        proxy_force_ranges on;
        proxy_cache_lock on;
        
        # Заголовки для отладки
        add_header X-Cache-Status $upstream_cache_status;
        add_header X-Redirected-From $target_url;
    }
    
    # Отдельный location для assets CDN (прямой доступ)
    location /assets/ {
        rewrite ^/assets/(.*) /$1 break;
        proxy_pass https://github_assets_cdn;
        
        proxy_set_header Host release-assets.githubusercontent.com;
        proxy_set_header Accept "*/*";
        proxy_set_header User-Agent "Mozilla/5.0 (compatible; Nginx-GitHub-Cache/1.0)";
        proxy_set_header X-Forwarded-Proto https;
        
        # SSL настройки
        proxy_ssl_server_name on;
        proxy_ssl_name release-assets.githubusercontent.com;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        
        # Настройки буферизации для больших файлов
        proxy_buffering on;
        proxy_buffer_size 512k;
        proxy_buffers 16 512k;
        proxy_busy_buffers_size 512k;
        proxy_temp_file_write_size 512k;
        
        # Таймауты
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        
        # Кэширование
        proxy_cache github_assets_cache;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale updating error timeout;
        proxy_force_ranges on;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 30s;
        
        # Заголовки
        add_header X-Cache-Status $upstream_cache_status;
        
        access_log /var/log/nginx/github-assets-cdn-access.log;
        error_log /var/log/nginx/github-assets-cdn-error.log;
    }
    
    # Health check endpoint
    location /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }
    
    # Cache stats endpoint
    location /nginx_status {
        stub_status;
        access_log off;
        allow 127.0.0.1;
        deny all;
    }
    
    # Cache management endpoint
    location /purge/ {
        allow 127.0.0.1;
        deny all;
    }
    
    # Default response
    location / {
        return 404 "Not Found\n";
        add_header Content-Type text/plain;
    }
}

# Optional: HTTPS configuration
{% if nginx_github_cache_ssl_enabled is defined and nginx_github_cache_ssl_enabled  %}
server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name {{ nginx_github_cache_server_name }};
    
    ssl_certificate {{ nginx_github_cache_ssl_cert }};
    ssl_certificate_key {{ nginx_github_cache_ssl_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    
    client_max_body_size 100m;
    
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;
    
    # Общие настройки
    proxy_redirect off;
    proxy_intercept_errors on;
    
    # Common proxy settings
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_ssl_server_name on;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;
    proxy_ssl_session_reuse on;
    
    # GitHub API endpoint
    location /api/ {
        rewrite ^/api/(.*) /$1 break;
        proxy_pass https://github_api;
        proxy_set_header Host api.github.com;
        proxy_set_header Accept "application/vnd.github.v3+json";
        proxy_pass_header Authorization;
        
        proxy_cache github_cache;
        proxy_cache_key "$scheme$request_method$host$request_uri$http_authorization$http_accept";
        proxy_cache_valid {{ nginx_github_cache_valid_codes }} {{ nginx_github_cache_valid_time }};
        add_header X-Cache-Status $upstream_cache_status;
    }
    
    # Raw GitHub content endpoint
    location /raw/ {
        rewrite ^/raw/(.*) /$1 break;
        proxy_pass https://github_raw;
        proxy_set_header Host raw.githubusercontent.com;
        
        proxy_cache github_cache;
        add_header X-Cache-Status $upstream_cache_status;
    }
    
    # GitHub releases endpoint - ИСПРАВЛЕННАЯ ВЕРСИЯ для HTTPS
    location /github/ {
        rewrite ^/github/(.*) /$1 break;
        
        proxy_pass https://github.com;
        
        proxy_set_header Host github.com;
        proxy_set_header Accept "*/*";
        proxy_set_header User-Agent "Mozilla/5.0 (compatible; Nginx-GitHub-Cache/1.0)";
        proxy_set_header X-Forwarded-Proto https;
        
        proxy_ssl_server_name on;
        proxy_ssl_name github.com;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        
        # Включаем перехват редиректов
        proxy_intercept_errors on;
        error_page 301 302 307 = @follow_redirect_https;
        
        proxy_buffering on;
        proxy_buffer_size 512k;
        proxy_buffers 16 512k;
        proxy_busy_buffers_size 512k;
        proxy_temp_file_write_size 512k;
        
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        
        proxy_cache github_assets_cache;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale updating error timeout;
        proxy_force_ranges on;
        proxy_cache_lock on;
        
        add_header X-Cache-Status $upstream_cache_status;
    }
    
    # Следуем за редиректом для HTTPS
    location @follow_redirect_https {
        internal;
        
        set $redirect_url $upstream_http_location;
        set $is_asset 0;
        
        if ($redirect_url ~* "release-assets\.githubusercontent\.com") {
            set $is_asset 1;
        }
        
        if ($is_asset = 1) {
            rewrite ^ /_proxy_asset_https?redirect=$redirect_url last;
        }
        
        return 302 $redirect_url;
    }
    
    # Внутренний location для проксирования assets (HTTPS)
    location /_proxy_asset_https {
        internal;
        
        set $target_url $arg_redirect;
        
        proxy_pass $target_url;
        
        proxy_set_header Host release-assets.githubusercontent.com;
        proxy_set_header Accept "*/*";
        proxy_set_header User-Agent "Mozilla/5.0 (compatible; Nginx-GitHub-Cache/1.0)";
        proxy_set_header X-Forwarded-Proto https;
        
        proxy_ssl_server_name on;
        proxy_ssl_name release-assets.githubusercontent.com;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        
        proxy_buffering on;
        proxy_buffer_size 512k;
        proxy_buffers 16 512k;
        proxy_busy_buffers_size 512k;
        proxy_temp_file_write_size 512k;
        
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        
        proxy_cache github_assets_cache;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale updating error timeout;
        proxy_force_ranges on;
        proxy_cache_lock on;
        
        add_header X-Cache-Status $upstream_cache_status;
        add_header X-Redirected-From $target_url;
    }
    
    # Отдельный location для assets CDN для HTTPS
    location /assets/ {
        rewrite ^/assets/(.*) /$1 break;
        proxy_pass https://github_assets_cdn;
        
        proxy_set_header Host release-assets.githubusercontent.com;
        proxy_set_header Accept "*/*";
        proxy_set_header User-Agent "Mozilla/5.0 (compatible; Nginx-GitHub-Cache/1.0)";
        proxy_set_header X-Forwarded-Proto https;
        
        proxy_ssl_server_name on;
        proxy_ssl_name release-assets.githubusercontent.com;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        
        proxy_buffering on;
        proxy_buffer_size 512k;
        proxy_buffers 16 512k;
        proxy_busy_buffers_size 512k;
        proxy_temp_file_write_size 512k;
        
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        
        proxy_cache github_assets_cache;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale updating error timeout;
        proxy_force_ranges on;
        proxy_cache_lock on;
        
        add_header X-Cache-Status $upstream_cache_status;
    }
    
    location /health {
        access_log off;
        return 200 "OK\n";
    }
    
    location /nginx_status {
        stub_status;
        access_log off;
        allow 127.0.0.1;
        deny all;
    }
}
{% endif  %}