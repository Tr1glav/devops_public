vrrp_script chk_haproxy {
    script "pidof haproxy"
    interval 2
    weight 2
}

vrrp_instance VI_1 {
    state {% if play_hosts.index(inventory_hostname) == 0  %}MASTER{% else  %}BACKUP{% endif  %}
    
    interface {{ haproxy_vip_interface }}
    virtual_router_id 51
    priority {% if play_hosts.index(inventory_hostname) == 0  %}101{% else  %}100{% endif  %}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass {{ _haproxy_vault_keepalived_secret.data.data.data.auth_pass }}
    }
    virtual_ipaddress {
        {{ haproxy_vip_address }}
    }
    track_script {
        chk_haproxy
    }
}