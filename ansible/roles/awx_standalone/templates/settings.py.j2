ADMINS = ()

STATIC_ROOT = '{{ awx_data_dir }}/public/static'
PROJECTS_ROOT = '{{ awx_projects_dir }}'
JOBOUTPUT_ROOT = '{{ awx_data_dir }}/job_status'

SECRET_KEY = open('{{ awx_config_dir }}/SECRET_KEY', 'rb').read().strip()

ALLOWED_HOSTS = ['*']
CSRF_TRUSTED_ORIGINS = {{ awx_csrf_trusted_origins | to_json }}

CLUSTER_HOST_ID = '{{ ansible_hostname }}'
