[Unit]
Description=AWX Daphne ASGI Server
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User={{ awx_user }}
Group={{ awx_group }}
WorkingDirectory={{ awx_source_dir }}
Environment=DJANGO_SETTINGS_MODULE=awx.settings.production
Environment=AWX_SETTINGS_FILE={{ awx_config_dir }}/settings.py
ExecStart={{ awx_venv_dir }}/bin/daphne -b 127.0.0.1 -p {{ awx_daphne_port }} awx.asgi:application
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
