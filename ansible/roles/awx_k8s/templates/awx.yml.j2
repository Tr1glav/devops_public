---
apiVersion: awx.ansible.com/v1beta1
kind: AWX
metadata:
  name: {{ awx_k8s_instance_name }}
  namespace: {{ awx_k8s_namespace }}
spec:
  admin_user: {{ awx_k8s_admin_user }}
  admin_password_secret: {{ awx_k8s_instance_name }}-admin-password

  service_type: {{ awx_k8s_service_type }}
{% if awx_k8s_service_type == 'NodePort' %}
  nodeport_port: {{ awx_k8s_nodeport_port }}
{% endif %}

  ingress_type: {{ awx_k8s_ingress_type }}
{% if awx_k8s_ingress_type == 'ingress' %}
  hostname: {{ awx_k8s_domain }}
  ingress_class_name: {{ awx_k8s_ingress_class }}
{% if awx_k8s_enable_ssl %}
  ingress_tls_secret: {{ awx_k8s_instance_name }}-tls
{% endif %}
{% endif %}

{% if awx_k8s_postgres_type == 'unmanaged' %}
  postgres_configuration_secret: {{ awx_k8s_instance_name }}-postgres-configuration
{% else %}
  postgres_storage_requirements:
    requests:
      storage: {{ awx_k8s_postgres_storage_size }}
{% if awx_k8s_storage_class | length > 0 %}
  postgres_storage_class: {{ awx_k8s_storage_class }}
{% endif %}
{% endif %}

  projects_persistence: {{ awx_k8s_projects_persistence | lower }}
{% if awx_k8s_projects_persistence %}
  projects_storage_size: {{ awx_k8s_projects_storage_size }}
  projects_storage_access_mode: {{ awx_k8s_projects_storage_access_mode }}
{% if awx_k8s_storage_class | length > 0 %}
  projects_storage_class: {{ awx_k8s_storage_class }}
{% endif %}
{% endif %}

  web_replicas: {{ awx_k8s_web_replicas }}
  task_replicas: {{ awx_k8s_task_replicas }}

  web_resource_requirements:
{{ awx_k8s_web_resources | to_nice_yaml(indent=2) | indent(4, true) }}
  task_resource_requirements:
{{ awx_k8s_task_resources | to_nice_yaml(indent=2) | indent(4, true) }}
  ee_resource_requirements:
{{ awx_k8s_ee_resources | to_nice_yaml(indent=2) | indent(4, true) }}
{% if awx_k8s_extra_settings | length > 0 %}

  extra_settings:
{{ awx_k8s_extra_settings | to_nice_yaml(indent=2) | indent(4, true) }}
{% endif %}
