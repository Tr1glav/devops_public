---
apiVersion: v1
kind: Secret
metadata:
  name: {{ awx_k8s_instance_name }}-postgres-configuration
  namespace: {{ awx_k8s_namespace }}
type: Opaque
stringData:
  host: "{{ awx_k8s_db_host }}"
  port: "{{ awx_k8s_db_port }}"
  database: "{{ awx_k8s_db_name }}"
  username: "{{ awx_k8s_db_user }}"
  password: "{{ awx_k8s_db_password }}"
  sslmode: "{{ awx_k8s_db_sslmode }}"
  type: "unmanaged"
