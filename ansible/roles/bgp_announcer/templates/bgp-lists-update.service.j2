---
[Unit]
Description=Update BGP announced prefixes from external lists
Wants=network-online.target
After=network-online.target bird.service

[Service]
Type=oneshot
ExecStart={{ bgp_announcer_script_path }} --sources {{ bgp_announcer_state_dir }}/sources.list --output {{ bgp_announcer_announced_file }} --min-prefixlen {{ bgp_announcer_min_prefixlen }} --max-prefixes {{ bgp_announcer_max_prefixes }} --guard-state {{ bgp_announcer_guard_state }}
TimeoutStartSec=300
