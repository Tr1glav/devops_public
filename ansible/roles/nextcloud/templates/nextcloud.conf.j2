server {
    listen 80;
    server_name {{ nextcloud_domain }};
    
    # Перенаправление на HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ nextcloud_domain }};
    
    # ВСТАВЬТЕ ЭТО - подключение стандартных MIME-типов
    include /etc/nginx/mime.types;
    
    # Дополнительные/переопределяющие MIME-типы
    types {
        application/javascript mjs;
        text/css css;
    }
    
    # SSL Configuration (ваша существующая конфигурация)
    ssl_certificate /etc/nginx/ssl/{{ nextcloud_domain }}.crt;
    ssl_certificate_key /etc/nginx/ssl/{{ nextcloud_domain }}.key;
    ssl_trusted_certificate /etc/nginx/ssl/{{ nextcloud_domain }}-combined.crt;
    
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;
    
    # Security Headers
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Robots-Tag none always;
    add_header X-Download-Options noopen always;
    add_header X-Permitted-Cross-Domain-Policies none always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    
    root /var/www/nextcloud/;
    
    client_max_body_size {{ nextcloud_nginx_client_max_body_size | default('16G') }};
    fastcgi_buffers {{ nextcloud_nginx_fastcgi_buffers | default('64 4K') }};
    
    gzip on;
    gzip_vary on;
    gzip_comp_level {{ nextcloud_nginx_gzip_comp_level | default(4) }};
    gzip_min_length {{ nextcloud_nginx_gzip_min_length | default(256) }};
    gzip_proxied expired no-cache no-store private no_last_modified no_etag auth;
    gzip_types application/atom+xml application/javascript application/json application/ld+json application/manifest+json application/rss+xml application/vnd.geo+json application/vnd.ms-fontobject application/x-font-ttf application/x-web-app-manifest+json application/xhtml+xml application/xml font/opentype image/bmp image/svg+xml image/x-icon text/cache-manifest text/css text/plain text/vcard text/vnd.rim.location.xloc text/vtt text/x-component text/x-cross-domain-policy;
    
    # Статические файлы - должны быть ПЕРЕД основным location /
    location ~ ^/dist/(.*\.(js|mjs|css|map))$ {
        try_files $uri /dist/$1 =404;
        expires 1M;
        add_header Cache-Control "public, immutable" always;
        access_log off;
        # Явно устанавливаем Content-Type
        if ($request_uri ~* \.css$) {
            add_header Content-Type text/css always;
        }
        if ($request_uri ~* \.js$) {
            add_header Content-Type application/javascript always;
        }
        if ($request_uri ~* \.mjs$) {
            add_header Content-Type application/javascript always;
        }
    }
    
    location ~ ^/core/js/(.*\.js)$ {
        try_files $uri /core/js/$1 =404;
        expires 1M;
        add_header Cache-Control "public, immutable" always;
        add_header Content-Type application/javascript always;
        access_log off;
    }
    
    location ~ ^/apps/([^/]+)/(js|css|img|fonts)/(.*)$ {
        try_files $uri /apps/$1/$2/$3 =404;
        expires 1M;
        add_header Cache-Control "public, immutable" always;
        access_log off;
        # Явно устанавливаем Content-Type
        if ($2 = "css") {
            add_header Content-Type text/css always;
        }
        if ($2 = "js") {
            add_header Content-Type application/javascript always;
        }
    }
    
    location ~ ^/themes/([^/]+)/(css|js|img|fonts)/(.*)$ {
        try_files $uri /themes/$1/$2/$3 =404;
        expires 1M;
        add_header Cache-Control "public, immutable" always;
        access_log off;
        if ($2 = "css") {
            add_header Content-Type text/css always;
        }
        if ($2 = "js") {
            add_header Content-Type application/javascript always;
        }
    }
    
    location ~ ^/js/(.*\.js)$ {
        try_files $uri /js/$1 =404;
        expires 1M;
        add_header Cache-Control "public, immutable" always;
        add_header Content-Type application/javascript always;
        access_log off;
    }
    
    # Основной location
    location / {
        rewrite ^ /index.php$request_uri;
    }
    
    location = /robots.txt {
        allow all;
        log_not_found off;
        access_log off;
    }
    
    location = /.well-known/carddav {
        return 301 $scheme://$host/remote.php/dav;
    }
    
    location = /.well-known/caldav {
        return 301 $scheme://$host/remote.php/dav;
    }
    
    location ~ /.well-known/acme-challenge {
        allow all;
    }
    
    location ~ /\.(ncdata|ocdata)$ {
        allow all;
        access_log off;
        log_not_found off;
    }
    
    location ~ ^/(?:build|tests|config|lib|3rdparty|templates|data)/ {
        deny all;
    }
    
    location ~ ^/(?:\.|autotest|occ|issue|indie|db_|console) {
        deny all;
    }
    
    # PHP обработчик
    location ~ ^/(?:index|remote|public|cron|core/ajax/update|status|ocs/v[12]|updater/.+|ocs-provider/.+|core/templates/40[34])\.php(?:$|/) {
        fastcgi_split_path_info ^(.+?\.php)(/.*)$;
        set $path_info $fastcgi_path_info;
        try_files $fastcgi_script_name =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $path_info;
        fastcgi_param HTTPS on;  # ИСПРАВЛЕНО: должно быть "on" для HTTPS
        fastcgi_param modHeadersAvailable true;
        fastcgi_param front_controller_active true;
        fastcgi_pass unix:/var/run/php/php{{ nextcloud_php_version }}-fpm-nextcloud.sock;
        fastcgi_intercept_errors on;
        fastcgi_request_buffering off;
        fastcgi_read_timeout {{ nextcloud_nginx_fastcgi_read_timeout | default(3600) }};
    }
    
    location ~ ^/(?:updater|ocs-provider)(?:$|/) {
        try_files $uri/ =404;
        index index.php;
    }
    
    location ~ \.(?:css|js|svg|gif|png|jpg|ico)$ {
        try_files $uri /index.php$request_uri;
        expires {{ nextcloud_nginx_static_expires | default('6M') }};
        access_log off;
        # Явно устанавливаем Content-Type
        if ($request_uri ~* \.css$) {
            add_header Content-Type text/css always;
        }
        if ($request_uri ~* \.js$) {
            add_header Content-Type application/javascript always;
        }
    }
    
    location ~ \.woff2?$ {
        try_files $uri /index.php$request_uri;
        expires {{ nextcloud_nginx_fonts_expires | default('7d') }};
        access_log off;
    }
    
    location ~ /\.ht {
        deny all;
    }
}